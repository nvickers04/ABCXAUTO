# xAI / Grok (required)
XAI_API_KEY=

# MarketData.app (required for quotes/chains/news)
MARKETDATA_TOKEN=

# IBKR TWS / Gateway
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=42
TRADING_MODE=paper

# Trading objective (injected at startup)
# ABCXAUTO_TRADING_MANDATE=Manage the portfolio autonomously. Focus on protection first.

# Optional overrides
# ABCXAUTO_MODEL=grok-4.3
# ABCXAUTO_TEMPERATURE=0.3
# ABCXAUTO_MAX_TOKENS=8192
# ABCXAUTO_SYSTEM_PROMPT_EXTRA=

# Opportunity scans during market hours
# ABCXAUTO_SCAN_ENABLED=true
# ABCXAUTO_SCAN_INTERVAL_S=900

# Background P&L monitor
# ABCXAUTO_MONITOR_ENABLED=true
# ABCXAUTO_MONITOR_POLL_S=30
# ABCXAUTO_MONITOR_REVIEW_S=300
# ABCXAUTO_MONITOR_EXTENDED_HOURS=false

# Web dashboard (python -m abcxauto.web)
# ABCXAUTO_WEB_HOST=127.0.0.1
# ABCXAUTO_WEB_PORT=8000
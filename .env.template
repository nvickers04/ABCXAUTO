# ABCXAUTO shell: connections (TWS + XAI + optional MDA) → book/risk/send → ORDER EXAMPLES.
# Default: python -m abcxauto --headless  (autonomous paper; Ctrl+C = kill switch)
# UI: python -m abcxauto  (status + kill switch). Grok self_tunes all non-risk knobs.

# xAI / Grok (required)
XAI_API_KEY=

# MarketData.app (optional — quotes/chains/news; agent can run without it)
MARKETDATA_TOKEN=

# IBKR TWS / Gateway
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=42
TRADING_MODE=paper
# Paper ports ONLY: 7497 (TWS) or 4002 (Gateway). Live ports ONLY: 7496 / 4001.
# LIVE TRADING IS IRREVERSIBLE REAL MONEY. Leave unset for paper.
# To enable live: TRADING_MODE=live, IBKR_PORT=7496 (or 4001), AND set the exact phrase below.
# ABCXAUTO_LIVE_CONFIRM=I_UNDERSTAND_LIVE_TRADING_RISK
# If TWS/Gateway stays disconnected this many seconds, risk gate HALTs new entries (0 disables).
# ABCXAUTO_DISCONNECT_HALT_S=120

# $1000 trading budget (sleeve). IBKR paper NetLiq can be $1M; Grok sizes
# against min(NetLiq, budget). Agent may lower the sleeve, never raise it.
# ABCXAUTO_TRADING_BUDGET_USD=1000
# ABCXAUTO_CYCLE_SLEEP_S=300
# ABCXAUTO_GROK_MIN_INTERVAL_S=300
# ABCXAUTO_PACE_PROTECT_S=20
# ABCXAUTO_PACE_MANAGE_S=60
# ABCXAUTO_PACE_IDLE_S=600
# ABCXAUTO_SCAN_FETCH_CAP=4

# Background P&L monitor
# ABCXAUTO_MONITOR_ENABLED=true
# ABCXAUTO_MONITOR_POLL_S=30
# ABCXAUTO_MONITOR_REVIEW_S=300
# ABCXAUTO_MONITOR_EXTENDED_HOURS=false

# Order suite: paper place→cancel by default (paper mode only).
# ABCXAUTO_SUITE_PAPER_PLACE=true

# Walk-away floor (ON). Percents apply to the trading-budget sleeve.
# Agent self_tune cannot disable or raise these ceilings.
# ABCXAUTO_RISK_POSTURE=defensive
# ABCXAUTO_RISK_GATES_ENABLED=true
# ABCXAUTO_DAILY_LOSS_LIMIT_PCT=2
# ABCXAUTO_MAX_POSITION_PCT=20
# ABCXAUTO_AUTO_PANIC_ON_BREACH=true
# ABCXAUTO_DEFINED_RISK_ONLY=true
# ABCXAUTO_CASH_ONLY=true
# ABCXAUTO_MAX_PEAK_DRAWDOWN_PCT=8
# ABCXAUTO_MAX_OPTION_PREMIUM_PCT=5
# ABCXAUTO_MAX_RISK_PER_TRADE_PCT=1
# ABCXAUTO_MAX_OPEN_POSITIONS=2
# Agent-owned Controls (self_tune). Defaults are conservative for model cost.
# ABCXAUTO_CONTROL_DELIBERATION_PCT=40
# ABCXAUTO_CONTROL_BUDGET_PCT=25
# ABCXAUTO_CONTROL_FREQUENCY_PCT=30
# ABCXAUTO_CONTROL_ROTATION_PCT=40
# ABCXAUTO_CONTROL_ENTRY_SURFACE_PCT=50
# ABCXAUTO_CONTROL_COMPLEXITY_PCT=40
# ABCXAUTO_UNIVERSE_PATH=universe_allowlist.json
# ABCXAUTO_RISK_SETTINGS_PATH=risk_settings.json
# ABCXAUTO_AGENT_STATE_PATH=agent_state.json

# Trade journal (SQLite)
# ABCXAUTO_JOURNAL_ENABLED=true
# ABCXAUTO_JOURNAL_PATH=journal.db

# Optional model-cost rates for the scorecard ($ / million tokens)
# ABCXAUTO_MODEL_INPUT_USD_PER_MTOK=3
# ABCXAUTO_MODEL_OUTPUT_USD_PER_MTOK=15

# Optional IBKR connector tuning
# IBKR_CONNECT_MAX_ATTEMPTS=12
# IBKR_HEARTBEAT_INTERVAL_S=60
# IBKR_HEARTBEAT_FAST_INTERVAL_S=15

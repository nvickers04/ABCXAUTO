# ABCXAUTO shell: connections (TWS + XAI + optional MDA) → book/risk/send → ORDER EXAMPLES.
# Default runtime is Pro UI (python -m abcxauto); START AUTONOMOUS owns the loop.

# xAI / Grok (required)
XAI_API_KEY=

# MarketData.app (optional — quotes/chains/news; agent can run without it)
MARKETDATA_TOKEN=

# IBKR TWS / Gateway
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=42
TRADING_MODE=paper
# Paper ports ONLY: 7497 (TWS) or 4002 (Gateway). Live ports ONLY: 7496 / 4001.
# LIVE TRADING IS IRREVERSIBLE REAL MONEY. Leave unset for paper.
# To enable live: TRADING_MODE=live, IBKR_PORT=7496 (or 4001), AND set the exact phrase below.
# ABCXAUTO_LIVE_CONFIRM=I_UNDERSTAND_LIVE_TRADING_RISK
# If TWS/Gateway stays disconnected this many seconds, risk gate HALTs new entries (0 disables).
# ABCXAUTO_DISCONNECT_HALT_S=120

# Trading objective (injected at startup). Default: agentic portfolio — protect first;
# hold valid when protected; hold forbidden only while unprotected STK.
# ABCXAUTO_TRADING_MANDATE=
# Optional human beliefs only (empty = none). Env overrides operator_card.txt.
# ABCXAUTO_OPERATOR_CARD=
# ABCXAUTO_OPERATOR_CARD_PATH=

# Optional overrides
# ABCXAUTO_MODEL=grok-4.5
# ABCXAUTO_TEMPERATURE=0.3
# ABCXAUTO_MAX_TOKENS=8192
# ABCXAUTO_SYSTEM_PROMPT_EXTRA=

# Autonomous cycle cadence (Pro START AUTONOMOUS)
# Idle sleep between cycles (was 8s — that burned credits every loop).
# ABCXAUTO_CYCLE_SLEEP_S=120
# Min seconds between Grok decision calls when flat/protected.
# ABCXAUTO_GROK_MIN_INTERVAL_S=120

# Background P&L monitor (Pro cockpit)
# ABCXAUTO_MONITOR_ENABLED=true
# ABCXAUTO_MONITOR_POLL_S=30
# ABCXAUTO_MONITOR_REVIEW_S=300
# ABCXAUTO_MONITOR_EXTENDED_HOURS=false

# Order suite: Pro Test Suite place→cancel on paper by default (paper mode only).
# Startup schema check stays dry-run. Set false to force dry-run on Re-test all.
# ABCXAUTO_SUITE_PAPER_PLACE=true

# DEPRECATED — legacy web dashboard only (Pro path ignores). Signals module removed;
# ABCXAUTO_SIGNAL_ONLY / SIGNAL_RESOLUTION / SIGNAL_SYMBOLS are no longer loaded.
# ABCXAUTO_SCAN_ENABLED=false
# ABCXAUTO_SCAN_INTERVAL_S=900
# ABCXAUTO_WEB_HOST=127.0.0.1
# ABCXAUTO_WEB_PORT=8000

# Risk — operator sets posture (Risk tab Apply); agent sizes per trade + set_risk in envelope.
# ABCXAUTO_RISK_POSTURE=balanced
# ABCXAUTO_RISK_GATES_ENABLED=true
# ABCXAUTO_DAILY_LOSS_LIMIT_PCT=0
# ABCXAUTO_MAX_POSITION_PCT=0
# ABCXAUTO_MAX_OPEN_POSITIONS=0
# ABCXAUTO_MAX_DAILY_TRADES=0
# ABCXAUTO_AUTO_PANIC_ON_BREACH=false
# ABCXAUTO_DEFINED_RISK_ONLY=false
# ABCXAUTO_CASH_ONLY=false
# ABCXAUTO_MAX_PEAK_DRAWDOWN_PCT=0
# ABCXAUTO_MAX_OPTION_PREMIUM_PCT=0
# ABCXAUTO_MAX_RISK_PER_TRADE_PCT=0
# ABCXAUTO_MIN_REWARD_RISK=0
# Risk-tab Apply writes risk_settings.json (gitignored; overrides env above).
# ABCXAUTO_RISK_SETTINGS_PATH=risk_settings.json

# Trade journal (SQLite; read directly by abcxauto.memory.journal)
# ABCXAUTO_JOURNAL_ENABLED=true
# ABCXAUTO_JOURNAL_PATH=journal.db

# Optional IBKR connector tuning (not in Config — read by connector.py)
# IBKR_CONNECT_MAX_ATTEMPTS=12
# IBKR_HEARTBEAT_INTERVAL_S=60
# IBKR_HEARTBEAT_FAST_INTERVAL_S=15
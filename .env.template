# ABCXAUTO: TWS + xAI (+ optional MDA) → facts/gates/send.
# python -m abcxauto   Pro + supervisor + Grok stream
# Console-only: ABCXAUTO_FORCE_HEADLESS=1
# Settings / risk_settings.json > env > default.
# Overnight park is code. Stay-up has no sit clock. set_wake is never offered.

# xAI / Grok (required)
XAI_API_KEY=
# Brain. Default grok-4.6. Pro Settings owns the model knob and wins over this.
# When grok-4.7 is available, set the id here or in Settings — no code edit.
# ABCXAUTO_MODEL=grok-4.6
# Session brains (empty = ABCXAUTO_MODEL / Settings model). RTH thin sender;
# premarket/AH research has no send.
# ABCXAUTO_MODEL_RTH=
# ABCXAUTO_MODEL_RESEARCH=
# Extra chat.create kwargs as a JSON object. Unknown keys pass through
# (effort / thinking / reasoning_effort / whatever 4.7 adds). Empty = none.
# Dedicated knobs (model, temperature, max_tokens) win if repeated here.
# Session maps fall back to ABCXAUTO_MODEL_PARAMS when empty.
# ABCXAUTO_MODEL_PARAMS={"reasoning_effort":"high"}
# ABCXAUTO_MODEL_PARAMS_RTH=
# ABCXAUTO_MODEL_PARAMS_RESEARCH=
# ABCXAUTO_TEMPERATURE=0.3
# ABCXAUTO_MAX_TOKENS=8192
# ABCXAUTO_SESSION_LOOK_CAP=160
# ABCXAUTO_SESSION_TOKEN_CAP=2500000
# ABCXAUTO_PCS_KILL_LOOK=true

# MarketData.app (optional — scan/news/greeks; ~15m delayed. candles are IBKR)
MARKETDATA_TOKEN=

# IBKR TWS / Gateway
# Pro Settings may move host / client id only while the desk is disconnected.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=42
# TWS execDetails zone. Must match the TWS clock (Configure → Display).
# This desk shows CDT/CST — IANA America/Chicago so the offset follows DST.
# A fixed UTC-5 stays wrong after the fall-back. A mismatch writes fills on
# the wrong ET day (journal / scorecard). scripts/fix_fill_timestamps.py
# backfills historical rows only — ingest uses this zone at the source.
# ABCXAUTO_TWS_TIMEZONE=America/Chicago
TRADING_MODE=paper
# Paper ports ONLY: 7497 (TWS) or 4002 (Gateway). Live ports ONLY: 7496 / 4001.
# LIVE TRADING IS IRREVERSIBLE REAL MONEY. Leave unset for paper.
# To enable live: TRADING_MODE=live, IBKR_PORT=7496 (or 4001), AND set the exact phrase below.
# ABCXAUTO_LIVE_CONFIRM=I_UNDERSTAND_LIVE_TRADING_RISK
# If TWS/Gateway stays disconnected this many seconds, risk gate HALTs new entries (0 disables).
# ABCXAUTO_DISCONNECT_HALT_S=120
# IBKR_CONNECT_MAX_ATTEMPTS=12
# IBKR_HEARTBEAT_INTERVAL_S=60
# IBKR_HEARTBEAT_FAST_INTERVAL_S=15
# ABCXAUTO_TWS_TIMEZONE=UTC

# Size / loss / scorecard are % of full NetLiq (0 = no dollar sleeve).
# ABCXAUTO_TRADING_BUDGET_USD=0
# ABCXAUTO_TARGET_CAPITAL=0
# ABCXAUTO_SCAN_FETCH_CAP=8
# ABCXAUTO_SCAN_QUOTE_CAP=12

# Overnight / after-close park seconds (not an RTH sit clock). Stay-up is 0.
# ABCXAUTO_DEFAULT_LOOK_S=90
# ABCXAUTO_MIN_LOOK_S=30
# ABCXAUTO_MTM_BUCKET_PCT=8

# Background P&L monitor
# ABCXAUTO_MONITOR_ENABLED=true
# ABCXAUTO_MONITOR_POLL_S=30
# ABCXAUTO_MONITOR_REVIEW_S=300
# ABCXAUTO_MONITOR_EXTENDED_HOURS=false

# Walk-away floor (ON). Percents apply to full NetLiq.
# Agent self_tune cannot disable or raise these ceilings.
# ABCXAUTO_RISK_GATES_ENABLED=true
# ABCXAUTO_SIZING_FLOORS=false
# ABCXAUTO_RISK_POSTURE=defensive
# ABCXAUTO_DAILY_LOSS_LIMIT_PCT=25
# ABCXAUTO_MAX_POSITION_PCT=25
# ABCXAUTO_MAX_SYMBOL_CONCENTRATION_PCT=25
# ABCXAUTO_MAX_ARENA_CONCENTRATION_PCT=25
# ABCXAUTO_AUTO_PANIC_ON_BREACH=true
# ABCXAUTO_DEFINED_RISK_ONLY=true
# ABCXAUTO_CASH_ONLY=true
# ABCXAUTO_MAX_PEAK_DRAWDOWN_PCT=25
# ABCXAUTO_MAX_OPTION_PREMIUM_PCT=25
# ABCXAUTO_MAX_RISK_PER_TRADE_PCT=25
# ABCXAUTO_MAX_OPEN_POSITIONS=0
# Portfolio defined-max-loss display figure (USD). Not a place/preview refuse.
# Default 800 is not a gate. self_tune cannot persist over the file.
# ABCXAUTO_PORTFOLIO_CAP_USD=800
# Watchlist path (scan seed; send is not limited to it).
# ABCXAUTO_UNIVERSE_PATH=universe_allowlist.json
# ABCXAUTO_RISK_SETTINGS_PATH=risk_settings.json
# ABCXAUTO_AGENT_STATE_PATH=agent_state.json

# Path overrides (tests isolate these)
# ABCXAUTO_JOURNAL_ENABLED=true
# ABCXAUTO_JOURNAL_PATH=journal.db
# ABCXAUTO_LOG_PATH=logs/app.log
# ABCXAUTO_GROK_WAKE_PATH=data/state/grok_wake.json
# ABCXAUTO_SESSION_CAPS_PATH=
# ABCXAUTO_RESEARCH_BRIEF_PATH=
# ABCXAUTO_RESEARCH_BUDGET_PATH=
# ABCXAUTO_STRUCTURE_EVENTS_PATH=
# ABCXAUTO_WORKING_MEMORY_PATH=
# ABCXAUTO_TRADE_PLAN_PATH=
# ABCXAUTO_TRADE_PLANS_PATH=
# ABCXAUTO_FLAT_STREAK_PATH=
# ABCXAUTO_DESK_BRIEF_PATH=
# ABCXAUTO_DESK_LOCK_PATH=
# ABCXAUTO_DESK_OUT_PATH=
# ABCXAUTO_OPERATOR_STOP_PATH=
# ABCXAUTO_START_PRO_PATH=
# ABCXAUTO_ODDS_URL=
# ABCXAUTO_PLACE_TOKEN_TTL_S=
# ABCXAUTO_TOKEN_TTL_S=
# ABCXAUTO_EMPTY_GROK_DEAD_S=
# ABCXAUTO_SILENT_GROK_TIP_S=

# Optional model-cost rates for the scorecard ($ / million tokens).
# Defaults are grok-4.6 list: $2 in / $0.50 cached / $6 out.
# ABCXAUTO_MODEL_INPUT_USD_PER_MTOK=2
# ABCXAUTO_MODEL_CACHED_USD_PER_MTOK=0.5
# ABCXAUTO_MODEL_OUTPUT_USD_PER_MTOK=6

# Launch / probe (process, not Settings)
# ABCXAUTO_FORCE_HEADLESS=1
# ABCXAUTO_SUPERVISED=1
# ABCXAUTO_LAUNCH_PROBE=1
# ABCXAUTO_AUTOSTART=1
# ABCXAUTO_NO_AUTOSTART=1
# ABCXAUTO_IN_CURSOR=1
# ABCXAUTO_NOT_CURSOR=1
# ABCXAUTO_UI_PROBE=
# ABCXAUTO_PRO_WEB=1

# Vestigial (unread in abcxauto/; do not delete — tests or scripts still mention them)
# ABCXAUTO_STAY_UP_RETRY_S — tests set it; pacing uses STAY_UP_RETRY_CAP_S
# ABCXAUTO_SESSION_PREP_PATH — tests only
# ABCXAUTO_SESSION_REVIEW_PATH — tests only
# ABCXAUTO_DESKTOP — desktop-icon script export; unread in the package
